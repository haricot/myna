{
  "manifest_version": 3,
  "name": "Myna Firefox Anchor + Navigation (experimental)",
  "version": "0.1.0",
  "description": "Explicit Firefox dictation anchor and opt-in, deterministic DOM navigation sidebar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-anchor@myna.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "menus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Armer l'ancre de dictée Myna"
  },
  "commands": {
    "_execute_action": {
      "description": "Armer ou désarmer le champ de dictée Myna"
    },
    "_execute_sidebar_action": {
      "description": "Ouvrir la navigation DOM Myna"
    }
  },
  "sidebar_action": {
    "default_title": "Myna Navigation",
    "default_panel": "sidebar.html",
    "open_at_install": false
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
